{
  "version": 1,
  "cases": [
    {
      "file": "alpha-fonts.jsonc",
      "name": "Shared JSONC https://example.invalid/a/*literal*/",
      "appearance": "dark",
      "colors": {
        "editor.foreground": "#abc",
        "editor.background": "#11223388",
        "editorCursor.foreground": "#f008",
        "editor.selectionBackground": "#1234"
      },
      "rules": [
        {
          "scopes": [],
          "style": {
            "foreground": "#abc",
            "background": "#fff",
            "fontStyle": "bold italic"
          }
        },
        {
          "scopes": [
            "keyword",
            "storage.type"
          ],
          "style": {
            "foreground": "#1234",
            "background": "#01020304",
            "fontStyle": null
          }
        },
        {
          "scopes": [
            "source.sql keyword.control"
          ],
          "style": {
            "foreground": "#112233",
            "background": null,
            "fontStyle": ""
          }
        },
        {
          "scopes": [
            "keyword - keyword.control"
          ],
          "style": {
            "foreground": "#fff",
            "background": null,
            "fontStyle": null
          }
        },
        {
          "scopes": [
            "(keyword | string)"
          ],
          "style": {
            "foreground": "#000",
            "background": null,
            "fontStyle": null
          }
        }
      ],
      "styles": [
        {
          "scopes": [
            "source.sql",
            "keyword.control.sql"
          ],
          "foreground": "#112233",
          "background": "#01020304",
          "fontStyle": ""
        },
        {
          "scopes": [
            "source.sql",
            "string.quoted.single.sql"
          ],
          "foreground": "#abc",
          "background": "#fff",
          "fontStyle": "bold italic"
        }
      ]
    },
