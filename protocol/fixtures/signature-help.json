      "name": "\"public\".calculate",
      "activeParameter": 1,
      "parameterText": "scale: integer = DEFAULT"
    },
    "catalog": [
      {
        "schema": "public",
        "name": "calculate",
        "kind": "function",
        "signatures": [
          {
            "parameters": [
              {
                "name": "value",
                "type": "integer"
              }
            ],
            "returnType": "integer"
          },
          {
            "parameters": [
              {
                "name": "scale",
                "type": "integer",
                "position": 2,
                "optional": true
              },
              {
                "name": "value",
                "type": "numeric",
                "position": 1
              }
            ],
            "returnType": "numeric"
          },
          {
            "parameters": [
              {
                "name": "values",
                "type": "text[]",
                "variadic": true
              }
            ],
            "returnType": "text"
          }
        ]
      }
    ]
  },
