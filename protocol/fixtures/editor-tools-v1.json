{
  "version": 1,
  "formatCases": [
    {
      "engine": "postgresql",
      "source": "select id,name from public.users where id=1;",
      "expected": "select id,\nname\nfrom public.users\nwhere id=1;"
    },
    {
      "engine": "mysql",
      "source": "select `order`,1.2300e+10 from `things` where id=2;",
      "expected": "select `order`,\n1.2300e+10\nfrom `things`\nwhere id=2;"
    },
    {
      "engine": "cassandra",
      "source": "SELECT id,value FROM demo.events WHERE id=123e4567-e89b-12d3-a456-426614174000;",
      "expected": "SELECT id,\nvalue\nFROM demo.events\nWHERE id=123e4567-e89b-12d3-a456-426614174000;"
    },
    {
      "engine": "mongodb",
      "source": "{\"collection\":\"🌍\",\"find\":{\"n\":1.2300e+10,\"n\":{\"$numberLong\":\"9223372036854775807\"}}}",
      "expected": "{\n    \"collection\": \"🌍\",\n    \"find\": {\n        \"n\": 1.2300e+10,\n        \"n\": {\n            \"$numberLong\": \"9223372036854775807\"\n        }\n    }\n}"
    }
  ],
  "rejectedCases": [
    {
      "engine": "postgresql",
      "source": "SELECT 'unfinished"
    },
    {
      "engine": "mysql",
      "source": "DELIMITER $$\nCREATE PROCEDURE p() BEGIN SELECT 1; END$$\nDELIMITER ;"
    },
    {
      "engine": "cassandra",
      "source": "CREATE FUNCTION f(v int) RETURNS NULL ON NULL INPUT RETURNS int LANGUAGE java AS $$return v;$$;"
    },
    {
      "engine": "mongodb",
      "source": "{\"find\":{"
    }
  ],
  "columnTypeCases": [
    {
      "engine": "postgresql",
      "source": "SELECT u.amount FROM public.users u",
      "caretText": "amount",
      "catalog": [
        {
          "schema": "public",
          "name": "users",
          "kind": "table",
          "columns": [
            "amount"
          ],
          "columnTypes": {
            "amount": "numeric(20,4)"
          }
        }
      ],
      "expectedType": "numeric(20,4)"
    },
    {
      "engine": "mysql",
      "source": "SELECT u.amount FROM app.users u",
      "caretText": "amount",
      "catalog": [
        {
          "schema": "app",
          "name": "users",
          "kind": "table",
          "columns": [
            "amount"
          ],
          "columnTypes": {
            "amount": "decimal(20,4) unsigned"
          }
        }
      ],
      "expectedType": "decimal(20,4) unsigned"
    },
    {
      "engine": "cassandra",
      "source": "SELECT details FROM demo.events",
      "caretText": "details",
      "catalog": [
        {
          "schema": "demo",
          "name": "events",
          "kind": "table",
          "columns": [
            "details"
          ],
          "columnTypes": {
            "details": "frozen<map<text, list<int>>>"
          }
        }
      ],
      "expectedType": "frozen<map<text, list<int>>>"
    },
    {
      "engine": "mongodb",
      "source": "{\"collection\":\"users\",\"find\":{\"amount\":1}}",
      "caretText": "amount",
      "catalog": [
        {
          "schema": "app",
          "name": "users",
          "kind": "table",
          "columns": [
            "amount"
          ],
          "columnTypes": {
            "amount": "128-bit decimal | 64-bit integer"
          }
        }
      ],
      "expectedType": "128-bit decimal | 64-bit integer"
    }
  ]
}
