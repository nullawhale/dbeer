// Generated resource inputs. Compile from this directory, then link the .res.
#include <windows.h>
#include <winver.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The locked GPUI Windows backend requests the host icon by integer ID 1.
@ICON@
1 RT_MANIFEST "@MANIFEST@"

1 VERSIONINFO
 FILEVERSION @FIXED_VERSION@
 PRODUCTVERSION @FIXED_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
@STRINGS@
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
